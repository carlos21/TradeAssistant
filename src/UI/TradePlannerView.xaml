<Window x:Class="TradeAssistant.UI.TradePlannerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TradeAssistant.UI"
        xmlns:domain="clr-namespace:TradeAssistant.Domain"
        Title="Trade Assistant"
        Width="300"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStyle="ToolWindow"
        Topmost="True"
        Background="#1E1E1E"
        Foreground="White"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <ObjectDataProvider x:Key="RiskModeValues" MethodName="GetValues"
                            ObjectType="{x:Type domain:RiskMode}"/>
        <!-- Input field style -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background"   Value="#2D2D2D"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="BorderBrush"  Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="4,2"/>
            <Setter Property="Height"       Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ComboBox style -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background"   Value="#2D2D2D"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="BorderBrush"  Value="#555"/>
            <Setter Property="Height"       Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Label style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="#AAAAAA"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize"     Value="12"/>
        </Style>

        <!-- Value display style -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Direction button -->
        <Style x:Key="DirectionButtonStyle" TargetType="Button">
            <Setter Property="FontSize"     Value="14"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="Height"       Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Foreground"   Value="White"/>
        </Style>

        <!-- Execute button -->
        <Style x:Key="ExecuteButtonStyle" TargetType="Button">
            <Setter Property="Background"   Value="#E65100"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontSize"     Value="14"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="Height"       Value="42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
        </Style>

        <!-- Tier button style -->
        <Style x:Key="TierButtonStyle" TargetType="Button">
            <Setter Property="Background"   Value="#3D3D3D"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Width"        Value="30"/>
            <Setter Property="Height"       Value="26"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="12">

        <!-- Header -->
        <TextBlock Text="TRADE ASSISTANT"
                   FontSize="11" FontWeight="Bold" Foreground="#888"
                   Margin="0,0,0,10"/>

        <!-- Direction toggle -->
        <Button Content="{Binding DirectionLabel}"
                Command="{Binding ToggleDirectionCommand}"
                Margin="0,0,0,10">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource DirectionButtonStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DirectionLabel}" Value="LONG">
                            <Setter Property="Background" Value="#2E7D32"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DirectionLabel}" Value="SHORT">
                            <Setter Property="Background" Value="#C62828"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <Separator Background="#333" Margin="0,0,0,10"/>

        <!-- SL Tier Selection -->
        <Border Background="#2D2D2D" BorderBrush="#555" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tier navigation -->
                <Button Grid.Row="0" Grid.Column="0" 
                        Content="▼" 
                        Command="{Binding CycleTierDownCommand}"
                        Style="{StaticResource TierButtonStyle}"
                        ToolTip="Shorter SL"/>
                
                <TextBlock Grid.Row="0" Grid.Column="1" 
                           Text="{Binding CurrentTierDisplay}" 
                           Style="{StaticResource ValueStyle}" 
                           FontSize="14"
                           HorizontalAlignment="Center"/>
                
                <Button Grid.Row="0" Grid.Column="2" 
                        Content="▲" 
                        Command="{Binding CycleTierUpCommand}"
                        Style="{StaticResource TierButtonStyle}"
                        ToolTip="Larger SL"/>

                <!-- SL Points display -->
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="{Binding SlPoints, StringFormat=SL: {0:F0} points}" 
                           Style="{StaticResource LabelStyle}" 
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </Grid>
        </Border>

        <!-- Risk inputs -->
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" Style="{StaticResource ComboBoxStyle}"
                      SelectedItem="{Binding RiskMode}"
                      ItemsSource="{Binding Source={StaticResource RiskModeValues}}"/>
            <TextBox   Grid.Column="1" Style="{StaticResource InputStyle}"
                       Text="{Binding RiskValue, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="R:R Ratio" Style="{StaticResource LabelStyle}"/>
            <TextBox   Grid.Column="1" Style="{StaticResource InputStyle}"
                       Text="{Binding RrRatio, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F1}}"/>
        </Grid>

        <Separator Background="#333" Margin="0,0,0,10"/>

        <!-- Live plan display -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Contracts"  Style="{StaticResource LabelStyle}"/>
            <TextBlock Grid.Column="1" Text="{Binding Contracts}" Style="{StaticResource ValueStyle}" FontSize="22"/>
        </Grid>

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Risk $"     Style="{StaticResource LabelStyle}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource ValueStyle}" Foreground="#EF5350"
                       Text="{Binding RiskDollars, StringFormat=${0:F0}}"/>
        </Grid>

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Profit $"   Style="{StaticResource LabelStyle}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource ValueStyle}" Foreground="#66BB6A"
                       Text="{Binding ProfitDollars, StringFormat=${0:F0}}"/>
        </Grid>

        <!-- ATM Strategy Name -->
        <Grid Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="ATM Strategy"   Style="{StaticResource LabelStyle}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource ValueStyle}" FontSize="11"
                       Text="{Binding AtmStrategyName}" Foreground="#FFA726"/>
        </Grid>

        <Separator Background="#333" Margin="0,6,0,10"/>

        <!-- ARMED indicator -->
        <Border Background="#F57F17" CornerRadius="4" Padding="8,4" Margin="0,0,0,8"
                Visibility="{Binding IsArmed, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="ARMED — Press SPACE to Execute"
                       FontWeight="Bold" Foreground="Black"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Status message -->
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="#AAAAAA" FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <!-- Execute button -->
        <Button Content="EXECUTE"
                Command="{Binding ExecuteCommand}"
                Style="{StaticResource ExecuteButtonStyle}"
                Margin="0,0,0,4"/>

        <!-- Hotkey hints -->
        <TextBlock Text="SPACE: Execute  |  ESC: Cancel"
                   Foreground="#666" FontSize="10"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0"/>

    </StackPanel>
</Window>
