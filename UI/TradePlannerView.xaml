<Window x:Class="TradeAssistant.UI.TradePlannerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TradeAssistant.UI"
        Title="Trade Assistant"
        Width="300"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStyle="ToolWindow"
        Topmost="True"
        Background="#1E1E1E"
        Foreground="White"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Input field style -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background"   Value="#2D2D2D"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="BorderBrush"  Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="4,2"/>
            <Setter Property="Height"       Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Label style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="#AAAAAA"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize"     Value="12"/>
        </Style>

        <!-- Value display style -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Direction button -->
        <Style x:Key="DirectionButtonStyle" TargetType="Button">
            <Setter Property="FontSize"     Value="14"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="Height"       Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Foreground"   Value="White"/>
        </Style>

        <!-- Execute button -->
        <Style x:Key="ExecuteButtonStyle" TargetType="Button">
            <Setter Property="Background"   Value="#E53935"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontSize"     Value="14"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="Height"       Value="42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="12">

        <!-- Header -->
        <TextBlock Text="TRADE ASSISTANT"
                   FontSize="11" FontWeight="Bold" Foreground="#888"
                   LetterSpacing="2" Margin="0,0,0,10"/>

        <!-- Direction toggle -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="{Binding DirectionLabel}"
                    Command="{Binding ToggleDirectionCommand}"
                    Style="{StaticResource DirectionButtonStyle}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource DirectionButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DirectionLabel}" Value="LONG">
                                <Setter Property="Background" Value="#1B5E20"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DirectionLabel}" Value="SHORT">
                                <Setter Property="Background" Value="#B71C1C"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <TextBlock Grid.Column="1"
                       Text="{Binding DirectionLabel}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16" FontWeight="Bold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DirectionLabel}" Value="LONG">
                                <Setter Property="Foreground" Value="#66BB6A"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DirectionLabel}" Value="SHORT">
                                <Setter Property="Foreground" Value="#EF5350"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Separator Background="#333" Margin="0,0,0,10"/>

        <!-- Risk inputs -->
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Risk %" Style="{StaticResource LabelStyle}"/>
            <TextBox   Grid.Column="1" Style="{StaticResource InputStyle}"
                       Text="{Binding RiskPercent, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F1}}"/>
        </Grid>

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Fixed Risk $" Style="{StaticResource LabelStyle}"/>
            <TextBox   Grid.Column="1" Style="{StaticResource InputStyle}"
                       Text="{Binding FixedRiskDollars, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F0}}"/>
        </Grid>

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="R:R Ratio" Style="{StaticResource LabelStyle}"/>
            <TextBox   Grid.Column="1" Style="{StaticResource InputStyle}"
                       Text="{Binding RrRatio, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F1}}"/>
        </Grid>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="BE at R:R" Style="{StaticResource LabelStyle}"/>
            <TextBox   Grid.Column="1" Style="{StaticResource InputStyle}"
                       Text="{Binding BreakEvenRr, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F1}}"/>
        </Grid>

        <Separator Background="#333" Margin="0,0,0,10"/>

        <!-- Live plan display -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Contracts"  Style="{StaticResource LabelStyle}"/>
            <TextBlock Grid.Column="1" Text="{Binding Contracts}" Style="{StaticResource ValueStyle}" FontSize="22"/>
        </Grid>

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Risk $"     Style="{StaticResource LabelStyle}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource ValueStyle}" Foreground="#EF5350"
                       Text="{Binding RiskDollars, StringFormat=${0:F0}}"/>
        </Grid>

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Profit $"   Style="{StaticResource LabelStyle}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource ValueStyle}" Foreground="#66BB6A"
                       Text="{Binding ProfitDollars, StringFormat=${0:F0}}"/>
        </Grid>

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="SL Price"   Style="{StaticResource LabelStyle}"/>
            <TextBlock Grid.Column="1" Text="{Binding StopPrice, StringFormat={}{0:F2}}" Style="{StaticResource ValueStyle}"/>
        </Grid>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="TP Price"   Style="{StaticResource LabelStyle}"/>
            <TextBlock Grid.Column="1" Text="{Binding TpPrice, StringFormat={}{0:F2}}" Style="{StaticResource ValueStyle}"/>
        </Grid>

        <!-- ARMED indicator -->
        <Border Background="#F57F17" CornerRadius="4" Padding="8,4" Margin="0,0,0,8"
                Visibility="{Binding IsArmed, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="ARMED — Press SPACE to Execute"
                       FontWeight="Bold" Foreground="Black"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Status message -->
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="#AAAAAA" FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <!-- Execute button -->
        <Button Content="EXECUTE (SPACE)"
                Command="{Binding ExecuteCommand}"
                Style="{StaticResource ExecuteButtonStyle}"
                Margin="0,0,0,4"/>

    </StackPanel>
</Window>
